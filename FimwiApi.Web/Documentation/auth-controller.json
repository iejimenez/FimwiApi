{
  "controller": {
    "name": "Auth",
    "basePath": "/api/v1/auth",
    "endpoints": {
      "Login": {
        "method": "POST",
        "path": "/auth/login",
        "description": "Inicia sesión de usuario",
        "parameters": {
          "body": {
            "type": "object",
            "schema": {
              "$ref": "#/definitions/LoginDto"
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login exitoso",
            "schema": {
              "type": "object",
              "properties": {
                "user": {
                  "$ref": "#/definitions/UserDto"
                },
                "token": {
                  "type": "string",
                  "description": "JWT token"
                }
              }
            }
          },
          "401": {
            "description": "Credenciales inválidas"
          }
        }
      },
      "Register": {
        "method": "POST",
        "path": "/auth/register",
        "description": "Registra un nuevo usuario",
        "parameters": {
          "body": {
            "type": "object",
            "schema": {
              "$ref": "#/definitions/RegisterDto"
            }
          }
        },
        "responses": {
          "201": {
            "description": "Usuario registrado exitosamente",
            "schema": {
              "type": "object",
              "properties": {
                "user": {
                  "$ref": "#/definitions/UserDto"
                },
                "token": {
                  "type": "string",
                  "description": "JWT token"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos"
          }
        }
      }
    },
    "definitions": {
      "UserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "username": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "roleId": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "name": {
                "type": "string"
              }
            }
          },
          "emailConfirmed": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "LoginDto": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "RegisterDto": {
        "type": "object",
        "required": ["username", "email", "password"],
        "properties": {
          "username": {
            "type": "string",
            "minLength": 3,
            "maxLength": 50
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 8
          }
        }
      }
    }
  }
} 